Window.SetBackgroundTopColor(0.03, 0.01, 0.07); Window.SetBackgroundBottomColor(0.12, 0.02, 0.22);
logo = Sprite(Image("logo.png")); logo.SetX(Window.GetWidth()/2 - 128); logo.SetY(Window.GetHeight()/2 - 160);
t = 0; fun refresh() { t++; logo.SetOpacity(0.55 + 0.45 * Math.Sin(t / 12)); } Plymouth.SetRefreshFunction(refresh);
